# Server Configuration
PORT=8012
HOST=0.0.0.0
DEBUG=true
PUBLIC_BASE_URL=https://your-ngrok-or-domain.ngrok-free.app

# Telephony Provider Selection: "twilio", "exotel", or "generic_sip"
TELEPHONY_PROVIDER=twilio

# ==========================================================
# 1. TWILIO TELEPHONY CONFIGURATION
# Sign up at: https://www.twilio.com/try-twilio
# Get free trial number + Account SID + Auth Token
# ==========================================================
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ==========================================================
# 2. EXOTEL TELEPHONY CONFIGURATION (INDIA VIRTUAL NUMBER)
# Sign up at: https://exotel.com
# Use Exotel Inbound Applet pointing to your Passthru Webhook
# ==========================================================
EXOTEL_ACCOUNT_SID=your_exotel_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_VIRTUAL_NUMBER=04466669000
EXOTEL_SUB_DOMAIN=api.exotel.com

# Languages
VOICE_DEFAULT_LANGUAGE=ta-IN
VOICE_FALLBACK_LANGUAGE=en-IN

# Emergency & Human Operator Transfer Lines
EMERGENCY_DESK_PHONE=+914466669999
HUMAN_OPERATOR_PHONE=+919876543210
EMERGENCY_DESK_SIP=sip:casualty-desk@hospital.local
HUMAN_AGENT_POOL_SIP=sip:contact-queue@hospital.local
