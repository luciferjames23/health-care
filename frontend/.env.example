# ==============================================================================
# Hospital Healthcare Platform - Frontend Environment Configuration Example
# Copy this file to .env or .env.local to customize your frontend endpoints.
# ==============================================================================

# Backend API Base URL (leave empty string to use relative proxy in development)
VITE_API_BASE_URL=

# Standalone Radiology PACS API URL (if running radiology microservice separately on port 8001)
VITE_RADIOLOGY_API_URL=http://localhost:8001

# OHIF Medical DICOM Viewer URL (Orthanc OHIF gateway)
VITE_OHIF_URL=http://localhost:3000
