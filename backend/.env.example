# ==============================================================================
# Hospital Healthcare Platform - Backend Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Server Configuration
PORT=8000
ENVIRONMENT=production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Authentication & Security
JWT_SECRET_KEY=your_production_secret_key_minimum_32_characters_random

# PostgreSQL Database Configuration
POSTGRES_HOST=your-postgres-host.example.com
POSTGRES_PORT=5432
POSTGRES_DB=your_database_name
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_database_password
DATABASE_SSLMODE=prefer

# Databricks Configuration (Optional / Lakehouse queries)
DATABRICKS_SERVER_HOSTNAME=your-databricks-instance.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
DATABRICKS_ACCESS_TOKEN=your-access-token
DATABRICKS_WORKSPACE_ID=your-workspace-id
DATABRICKS_CATALOG=health_care
DATABRICKS_SCHEMA=gold

# LLM & AI Agent Provider Configuration
# -----------------------------------------------
# PRIMARY LLM: GPT-6 Luna (OpenAI)
# LLM_PROVIDER options: gpt6luna | openai | gemini | google | ollama | mock
# Set LLM_PROVIDER=mock to use only rule-based fallback (offline/test mode)
# -----------------------------------------------
LLM_PROVIDER=gpt6luna
LLM_MODEL=gpt-6-luna
LLM_API_KEY=your_openai_api_key_for_gpt6_luna
LLM_API_BASE=https://api.openai.com/v1
# GPT-6 Luna reasoning effort: none|low|medium|high|xhigh (default: medium)
LLM_REASONING_EFFORT=medium
# HTTP timeout (seconds) for all LLM requests
LLM_TIMEOUT=12
# Set to 'true' to disable remote LLM calls (e.g. during unit tests)
# SKIP_REMOTE_LLM=false
GROQ_API_KEY=your_groq_api_key
# Legacy Gemini key (used as secondary fallback if configured)
GEMINI_API_KEY=your_gemini_api_key

# Agent-Specific LLM Models
DISCHARGE_LLM_MODEL=llama-3.3-70b-versatile
NURSING_AGENT_GROQ_API_KEY=your_nursing_groq_api_key
NURSING_AGENT_MODEL=llama-3.3-70b-versatile
BILLING_AGENT_GROQ_API_KEY=your_billing_groq_api_key
BILLING_AGENT_MODEL=llama-3.3-70b-versatile

# Meta WhatsApp Cloud API Configuration
META_WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
META_WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
META_WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_waba_id
META_WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token
META_GRAPH_API_VERSION=v25.0
META_APP_SECRET=your_meta_app_secret

# SMTP Email Configuration (Optional / Alerts & Notifications)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=notifications@hospital.com
SMTP_FROM_NAME=Hospital Care Team

# Radiology & PACS Service Configuration (Optional standalone microservice)
ORTHANC_URL=http://localhost:8042
RADIOLOGY_SERVICE_URL=http://localhost:8001
